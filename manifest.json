{
   "action": {
      "default_icon": {
         "128": "icons/icon-128.png",
         "16": "icons/icon-16.png",
         "48": "icons/icon-48.png"
      },
      "default_popup": "popup.html"
   },
   "content_scripts": [ {
      "js": [ "main.js" ],
      "matches": [ "https://*.leboncoin.fr/*" ],
      "run_at": "document_start",
      "world": "MAIN"
   }, {
      "js": [ "settings.js" ],
      "matches": [ "https://*.leboncoin.fr/*" ],
      "run_at": "document_start",
      "world": "ISOLATED"
   } ],
   "description": "Republiez vos annonces rapidement sur Leboncoin",
   "host_permissions": [ "https://*.leboncoin.fr/*" ],
   "icons": {
      "128": "icons/icon-128.png",
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
   },
   "manifest_version": 3,
   "name": "LebonCoinPro",
   "permissions": [ "storage" ],
   "version": "1.3.5"
}
